{
  "config": {
    "id": "cmd_fan",
    "neverStop": false,
    "curve": "function_curve",
    "useUnscaledCurveValues": false,
    "sanityCheck": {
      "pwmValueChangedByThirdParty": {
        "enabled": true
      },
      "fanModeChangedByThirdParty": {
        "enabled": true
      },
      "fanStalled": {
        "enabled": true
      }
    },
    "cmd": {
      "setPwm": {
        "exec": "/usr/bin/setpwm",
        "args": [
          "%pwm%"
        ]
      },
      "getPwm": {
        "exec": "/usr/bin/getpwm",
        "args": null
      },
      "getRpm": {
        "exec": "/usr/bin/getrpm",
        "args": [
          "-a"
        ]
      }
    }
  },
  "movingAvg": 3,
  "rpm": 500,
  "pwm": 50,
  "rpmMovingAvg": 0
}
